+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "test_macros_info.h"
+
+#define ASSERT_NOT_EQUAL_UINT16(exp, got) \
+    do { \
+      uint16_t _exp = (uint16_t)exp; \
+      uint16_t _got = (uint16_t)got; \
+      if ((exp) < 0 || (got) < 0) { \
+        PRINT_FAIL; \
+        printf("  [TST] NOT UINT16 (%d, %d)\n", exp, got); \
+        printf("  [EXP] %u\n", (exp)); \
+        printf("  [GOT] %u\n", (got)); \
+      } else \
+      if ((_exp) != (_got)) { \
+        PRINT_PASS; \
+      } else { \
+        PRINT_FAIL; \
+        printf("  [TST] ASSERT_NOT_EQUAL_UINT16(" #exp ", " #got ")\n"); \
+        printf("  [EXP] %d\n", (_exp)); \
+        printf("  [GOT] %d\n", (_got)); \
+      } \
+    } while (0);
+
+#define ASSERT_EQUAL_UINT16(exp, got) \
+    do { \
+      uint16_t _exp = (uint16_t)exp; \
+      uint16_t _got = (uint16_t)got; \
+      if ((exp) < 0 || (got) < 0) { \
+        PRINT_FAIL; \
