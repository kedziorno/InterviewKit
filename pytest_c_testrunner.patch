diff --git a/test/test_macros_info.h b/test/test_macros_info.h
new file mode 100644
index 0000000..e209ff6
--- /dev/null
+++ b/test/test_macros_info.h
@@ -0,0 +1,42 @@
+/*****************************************************************************
+ * Simple unit test macros for use with pytest_c_testrunner.
+ *
+ * Copyright 2014, John McNamara, jmcnamara@cpan.org
+ *
+ * Small refactoring : kndnooo@gmail.com
+ */
+
+#ifndef TEST_MACROS_INFO_H
+#define TEST_MACROS_INFO_H
+
+#include <stdint.h>
+
+//
+#define PRINT_COMPILATOR_INFO_WITH_STATUS(status)                             \
+  do {                                                                        \
+    uint32_t line = __LINE__;                                                 \
+    const char *file = __FILE__; \
+    const char *func = __FUNCTION__;\
+    printf("\n[" #status "] %s:%s():%d\n", file, func, line);         \
+  } while (0);
+
+//
+#define PRINT_INFO(status)                                                    \
+  do {                                                                        \
+    PRINT_COMPILATOR_INFO_WITH_STATUS(status);                                \
+  } while (0);
+
+//
+#define PRINT_PASS                                                            \
+  do {                                                                        \
+    PRINT_INFO(PASS);                                                         \
+  } while (0);
+
+//
+#define PRINT_FAIL                                                            \
+  do {                                                                        \
+    PRINT_INFO(FAIL);                                                         \
+  } while (0);
+
+#endif /* TEST_MACROS_INFO_H */
+
