+        printf("  [EXP] %d\n", (exp)); \
+        printf("  [GOT] %d\n", (got)); \
+      } else \
+      if ((_exp) == (_got)) { \
+        PRINT_PASS; \
+      } else { \
+        PRINT_FAIL; \
+        printf("  [TST] ASSERT_EQUAL_UINT16(" #exp ", " #got ")\n"); \
+        printf("  [EXP] %u\n", (_exp)); \
