+/*****************************************************************************
+ * Simple unit test macros for use with pytest_c_testrunner.
+ *
+ * Copyright 2014, John McNamara, jmcnamara@cpan.org
+ *
+ * Small refactoring : kndnooo@gmail.com
+ */
+
+#ifndef TEST_MACROS_UINT8_H
+#define TEST_MACROS_UINT8_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "test_macros_info.h"
+
+#define ASSERT_NOT_EQUAL_UINT8(exp, got) \
+    do { \
+      uint8_t _exp = (uint8_t)exp; \
+      uint8_t _got = (uint8_t)got; \
+      if ((exp) < 0 || (got) < 0) { \
+        PRINT_FAIL; \
+        printf("  [TST] NOT UINT8 (%d, %d)\n", exp, got); \
+        printf("  [EXP] %u\n", (exp)); \
+        printf("  [GOT] %u\n", (got)); \
+      } else \
+      if ((_exp) != (_got)) { \
+        PRINT_PASS; \
+      } else { \
+        PRINT_FAIL; \
+        printf("  [TST] ASSERT_NOT_EQUAL_UINT8(" #exp ", " #got ")\n"); \
+        printf("  [EXP] %d\n", (_exp)); \
+        printf("  [GOT] %d\n", (_got)); \
+      } \
+    } while (0);
+
+#define ASSERT_EQUAL_UINT8(exp, got) \
+    do { \
+      uint8_t _exp = (uint8_t)exp; \
+      uint8_t _got = (uint8_t)got; \
+      if ((exp) < 0 || (got) < 0) { \
+        PRINT_FAIL; \
+        printf("  [TST] NOT UINT8 (%d, %d)\n", exp, got); \
+        printf("  [EXP] %u\n", (exp)); \
+        printf("  [GOT] %u\n", (got)); \
+      } else \
+      if ((_exp) == (_got)) { \
+        PRINT_PASS; \
+      } else { \
+        PRINT_FAIL; \
+        printf("  [TST] ASSERT_EQUAL_UINT8(" #exp ", " #got ")\n"); \
+        printf("  [EXP] %d\n", (exp)); \
+        printf("  [GOT] %d\n", (got)); \
+      } \
+    } while (0);
+
+#endif /* TEST_MACROS_UINT8_H */
+
